<!-- HERO -->

<section class="training-hero">

    <div class="hero-content" data-aos="fade-up">

        <h1>Training & Certification</h1>

        <p>
            FCES Institute provides professional certification programs in
            NDT, QA/QC Engineering, Welding Inspection and Industrial Technologies.
        </p>

    </div>

</section>

<section class="og-courses-section">

    <h2 class="og-section-title" data-aos="fade-up">
        <i class="fa-solid fa-industry"></i> Engineering & Industrial Certification Courses
    </h2>

    <div class="og-courses-grid">

        <div class="og-course-box" data-aos="zoom-in">
            <div class="og-course-title">
                <div class="og-icon"><i class="fa-solid fa-microscope"></i></div>
                <h3>NDT (Non-Destructive Testing) Level – II</h3>
            </div>

            <p>
                Advanced inspection techniques used to evaluate materials and
                components without causing damage. Widely used in oil & gas,
                power plants and heavy engineering industries.
            </p>
        </div>


        <div class="og-course-box" data-aos="zoom-in">
            <div class="og-course-title">
            <div class="og-icon"><i class="fa-solid fa-gear"></i></div>

            <h3>Certification in QA / QC (Mechanical Engineering)</h3>
            </div>
            <p>
                Specialized training in quality assurance and quality control
                for mechanical engineering industries including welding,
                piping inspection and documentation standards.
            </p>
        </div>


        <div class="og-course-box" data-aos="zoom-in">
            <div class="og-course-title">
            <div class="og-icon"><i class="fa-solid fa-globe"></i></div>

            <h3>International Preparatory Courses</h3>
            </div>
            <p>
                Designed for candidates preparing for international certification
                programs conducted by UK and US organizations. These programs help
                professionals upgrade their career in the global job market.
            </p>
        </div>


        <div class="og-course-box" data-aos="zoom-in">
            <div class="og-course-title">
            <div class="og-icon"><i class="fa-solid fa-building"></i></div>

            <h3>Quantity Surveying</h3>
            </div>
            <p>
                A professional course for construction industry professionals
                focusing on project cost estimation, contract management and
                budgeting for infrastructure and industrial projects.
            </p>
        </div>

    </div>

</section>
