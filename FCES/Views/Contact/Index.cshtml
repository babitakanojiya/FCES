@{
    ViewData["Title"] = "contact";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Map and Contact Form</title>

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        /* HERO IMAGE */
        .hero-section {
            position: relative;
            width: 100%;
            height: 350px;
            background-image: url('/image/contact.jpg'); /* change your image path */
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* TEXT OVER IMAGE */
        .hero-title {
            font-size: 48px;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 0px 3px 10px rgba(0,0,0,0.6);
            animation: fadeIn 1.5s ease-in-out;
        }

        
        /* Same height cards */
        .equal-card {
            height: 100%;
        }

        /* Image fits inside without stretching */
        .map-image {
            width: 100%;
            height: 350px; /* You can change this height */
            object-fit: cover; /* Perfect cropping */
            border-radius: 8px;
        }

        @@keyframes fadeIn {
            0% {
                opacity: 0;
                transform: translateY(20px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        body {
            background: #f4f7fa;
        }
    </style>
</head>
<body>

    
    <div class="hero-section">
        <h1 class="hero-title">Contact</h1>
    </div>
    <div class="container mt-5">

        <div class="row g-4">

            <!-- LEFT SIDE – MAP -->
            <div class="col-md-6">
                <div class="card shadow-sm p-3 equal-card">
                    <img src="~/image/map.png" class="map-image" alt="Map" />
                </div>
            </div>

            <!-- RIGHT SIDE – CONTACT FORM -->
            <div class="col-md-6">
                <div class="card shadow-sm p-4 equal-card">
                    <h4 class="mb-3 fw-bold text-primary">Contact Details</h4>

                    <form>

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input type="text" class="form-control" placeholder="Enter full name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mobile Number</label>
                            <input type="text" class="form-control" placeholder="Enter mobile number" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email ID</label>
                            <input type="email" class="form-control" placeholder="Enter email" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Message</label>
                            <textarea class="form-control" rows="3" placeholder="Write message..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Submit</button>

                    </form>
                </div>
            </div>

        </div>

    </div>

    <!-- BOOTSTRAP JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
