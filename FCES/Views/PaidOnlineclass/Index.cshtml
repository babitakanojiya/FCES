@{
    ViewData["Title"] = "Paid Online Courses (e-Learning)";
}

<link href="~/css/course-page.css" rel="stylesheet" />
@model List<CourseModel>



<!-- HERO IMAGE WITH TEXT -->
<div class="hero-section">
    <h1 class="hero-title">Online Courses (e-Learning)</h1>   
</div>
<!-- PREMIUM TITLE SECTION -->
<div class="title-section">
    <h2 class="main-title">Explore Our Online Courses</h2>
    <p class="sub-title">
        FCES offers comprehensive paid online/e-training programs in NDT and QA/QC
        for professionals seeking flexible learning without compromising quality.
    </p>
</div>

<div class="course-wrapper">

    <!-- LEFT SIDE -->
    <div class="course-sidebar">

        @if (Model != null && Model.Any())
        {
            foreach (var parent in Model.GroupBy(x => x.ParentCourse))
            {
                <div class="course-group">

                    <!-- Parent Heading -->
                    <div class="parent-heading" onclick="loadFirstChild(this)">
                        @parent.Key
                    </div>

                    <!-- Child Courses -->
                    <div class="child-list">
                        @foreach (var item in parent)
                        {
                            <div class="child-item"
                                 data-url="@item.VideoUrl"
                                 onclick="loadVideo(this.dataset.url, this)">
                                ▶ @item.ChildCourse
                            </div>
                        }
                    </div>

                </div>
            }
        }
        else
        {
            <p>No courses available</p>
        }

    </div>

    <!-- RIGHT SIDE -->
    <div class="course-content">
        <iframe id="videoFrame" src="" allowfullscreen></iframe>

        <div class="video-placeholder" id="placeholder">
            <h2>Select a course to start learning</h2>
        </div>
    </div>

</div>
<script>
    function loadVideo(url, el) {
        document.getElementById("videoFrame").src = url;
        document.getElementById("placeholder").style.display = "none";

        // remove all active
        document.querySelectorAll(".child-item").forEach(x => x.classList.remove("active"));

        // set active
        if (el) {
            el.classList.add("active");
        }
    }

    // ✅ LOAD FIRST CHILD OF CLICKED PARENT
    function loadFirstChild(parentEl) {
        let parentGroup = parentEl.closest(".course-group");
        let firstChild = parentGroup.querySelector(".child-item");

        if (firstChild) {
            let url = firstChild.dataset.url;
            loadVideo(url, firstChild);
        }
    }

    // ✅ AUTO LOAD FIRST VIDEO ON PAGE LOAD
    window.onload = function () {
        let firstItem = document.querySelector(".child-item");

        if (firstItem) {
            let url = firstItem.dataset.url;
            loadVideo(url, firstItem);
        }
    };
</script>