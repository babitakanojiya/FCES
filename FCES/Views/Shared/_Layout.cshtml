<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Advantech</title>
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;500;700&display=swap" rel="stylesheet">
</head>

<body>
    <header class="header">
        <div class="container">
            <div class="header-left">
                <img src="~/image/logo.jpeg" alt="FCS Logo" class="logo" />
            </div>

            <div class="header-center">
                <h1>FOURM CONSULTING AND ENGINEERS SERVICES (FCES)</h1>
            </div>

            <div class="header-right">
                <p><strong>Email:</strong> info@fcs.com</p>
                <p><strong>Contact:</strong> +91 98765 43210</p>
            </div>
        </div>
    </header>
    <header>
    <nav class="navbar">
        <div class="container">
            <ul class="nav-list">
                <li><a asp-controller="Home" asp-action="Index" class="active">HOME</a></li>
                    <li><a asp-controller="AboutUs" asp-action="Index" >About Us</a></li>
                    

                <li class="dropdown">
                        <a href="#">COURSES & CERTIFICATIONS ▼</a>
                    <ul class="dropdown-menu">
                            <li><a asp-controller="Offlineclass" asp-action="Index">Off line (Classroom) Certification Programs</a></li>
                            <li><a asp-controller="PaidOnlineclass" asp-action="Index">Paid Online Courses (e-Learning)</a></li>
                        @* <li><a asp-controller="Courses" asp-action="HVAC">HVAC</a></li> *@
                    </ul>
                </li>

                <li><a asp-controller="Jobs" asp-action="Index">JOB OPENINGS</a></li>
                <li><a asp-controller="Gallery" asp-action="Index">GALLERY</a></li>
                    <li><a asp-controller="Blogvideo" asp-action="Index">BLOGS</a></li>
                <li><a asp-controller="Contact" asp-action="Index">CONTACT</a></li>
            </ul>
        </div>
    </nav>
</header>

<hr />

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer>
        <p>&copy; 2025 - FCS Engineering Pvt. Ltd.</p>
    </footer>

    <!-- JS Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 1200,
            once: true
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
