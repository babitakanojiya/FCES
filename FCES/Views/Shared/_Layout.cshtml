<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Advantech</title>
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>
    <header class="header">
        <div class="container">
            <div class="header-left">
                <img src="~/image/logo.jpeg" alt="FCS Logo" class="logo" />
            </div>

            <div class="header-center">
                <h1>FOURM CONSULTING AND ENGINEERS SERVICES (FCES)</h1>
            </div>

            <div class="header-right">
                <p><strong>Email:</strong> info@fcs.com</p>
                <p><strong>Contact:</strong> +91 98765 43210</p>
            </div>
        </div>
    </header>
    <header>
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        }

        <nav class="navbar">

            <div class="container nav-container">
                <div class="menu-toggle" id="menu-toggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <ul class="nav-list" id="nav-list">

                    <li>
                        <a asp-controller="Home" asp-action="Index"
                           class="@(currentController == "Home" ? "active" : "")">
                            HOME
                        </a>
                    </li>

                    <li class="dropdown">
                        <a href="#" class="@((currentController == "AboutUs" || currentController == "missionandvission") ? "active" : "")">
                            About Us ▼
                        </a>

                        <ul class="dropdown-menu">
                            <li>
                                <a asp-controller="AboutUs" asp-action="Index"
                                   class="@(currentController == "AboutUs" ? "active" : "")">
                                    About Us
                                </a>
                            </li>

                            <li>
                                <a asp-controller="missionandvission" asp-action="Index"
                                   class="@(currentController == "missionandvission" ? "active" : "")">
                                    Our Mission & Our Vision
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="dropdown">
                        <a href="#" class="@((currentController == "trainingandcertification" || currentController == "nondestruction" || currentController=="thirdpartmechanical" || currentController=="manpowersupply") ? "active" : "")">
                            Services ▼
                        </a>

                        <ul class="dropdown-menu">
                            <li>
                                <a asp-controller="trainingandcertification" asp-action="Index"
                                   class="@(currentController == "trainingandcertification" ? "active" : "")">
                                    Training and certification
                                </a>
                            </li>

                            <li>
                                <a asp-controller="nondestruction" asp-action="Index"
                                   class="@(currentController == "nondestruction" ? "active" : "")">
                                    Non-Destructive Testing & Inspection Services
                                </a>
                            </li>
                             <li>
                                <a asp-controller="thirdpartmechanical" asp-action="Index"
                                   class="@(currentController == "thirdpartmechanical" ? "active" : "")">
                                    Third-Party Mechanical Inspection Services
                                </a>
                            </li>
                            <li>
                                <a asp-controller="manpowersupply" asp-action="Index"
                                   class="@(currentController == "manpowersupply" ? "active" : "")">
                                    Manpower Supply Services
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="dropdown">
                        <a href="#" class="@((currentController == "Offlineclass" || currentController == "PaidOnlineclass" || currentController=="Certificate_Verification") ? "active" : "")">
                            COURSES & CERTIFICATIONS ▼
                        </a>

                        <ul class="dropdown-menu">
                            <li>
                                <a asp-controller="Offlineclass" asp-action="Index"
                                   class="@(currentController == "Offlineclass" ? "active" : "")">
                                    Off line (Classroom) Certification Programs
                                </a>
                            </li>

                            <li>
                                <a asp-controller="PaidOnlineclass" asp-action="Index"
                                   class="@(currentController == "PaidOnlineclass" ? "active" : "")">
                                    Paid Online Courses (e-Learning)
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Certificate_Verification" asp-action="Index"
                                   class="@(currentController == "Certificate_Verification" ? "active" : "")">
                                    Certificate Verification
                                </a>
                            </li>

                            
                        </ul>
                    </li>

                    <li>
                        <a asp-controller="Placement" asp-action="Index"
                           class="@(currentController == "Placement" ? "active" : "")">
                            Placement
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Gallery" asp-action="Index"
                           class="@(currentController == "Gallery" ? "active" : "")">
                            GALLERY
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Blogvideo" asp-action="Index"
                           class="@(currentController == "Blogvideo" ? "active" : "")">
                            BLOGS
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Contact" asp-action="Index"
                           class="@(currentController == "Contact" ? "active" : "")">
                            CONTACT
                        </a>
                    </li>
                    <li class="login-btn">
                        <a asp-controller="Account" asp-action="Login">Login</a>
                    </li>

                </ul>
            </div>
        </nav>
        <div class="menu-overlay" id="menu-overlay"></div>
</header>

<hr />

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    @* <footer>
        <p>&copy; 2025 - FCS Engineering Pvt. Ltd.</p>
    </footer>
 *@
    <footer class="mech-footer">

        <!-- WAVES -->
        <div class="waves">
            <span></span>
            <span></span>
            <span></span>
        </div>

        <div class="container mech-container">

            <!-- COMPANY -->
            <div class="mech-col">
                <h2 class="logo">⚙ FCES</h2>
                <p>
                    Delivering advanced mechanical inspection, NDT services,
                    certification, and engineering excellence.
                </p>

                <div class="mech-social">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                </div>
            </div>

            <!-- LINKS -->
            <div class="mech-col">
                <h3>Quick Links</h3>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="AboutUs" asp-action="Index">About</a></li>
                    <li><a asp-controller="Contact" asp-action="Index">Contact</a></li>
                    <li><a asp-controller="Gallery" asp-action="Index">Gallery</a></li>
                </ul>
            </div>

            <!-- SERVICES -->
            <div class="mech-col">
                <h3>Core Services</h3>
                <ul>
                    <li>⚙ NDT Inspection</li>
                    <li>⚙ Mechanical Testing</li>
                    <li>⚙ Certification</li>
                    <li>⚙ Manpower Supply</li>
                </ul>
            </div>

            <!-- CONTACT -->
            <div class="mech-col">
                <h3>Contact</h3>
                <p><i class="fas fa-envelope"></i> info@fcs.com</p>
                <p><i class="fas fa-phone"></i> +91 98765 43210</p>
                <p><i class="fas fa-map-marker-alt"></i> Mumbai, India</p>
            </div>

        </div>

        <div class="mech-bottom">
            © 2025 FCES Engineering Pvt. Ltd. | Designed with ⚙ Precision
        </div>

    </footer>
    <!-- JS Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 1200,
            once: true
        });

    </script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const toggle = document.getElementById("menu-toggle");
            const nav = document.getElementById("nav-list");
            const overlay = document.getElementById("menu-overlay");

            toggle.addEventListener("click", function () {
                toggle.classList.toggle("active");
                nav.classList.toggle("active");
                overlay.classList.toggle("active");
            });

            // CLOSE MENU ON OVERLAY CLICK
            overlay.addEventListener("click", function () {
                toggle.classList.remove("active");
                nav.classList.remove("active");
                overlay.classList.remove("active");
            });

            // DROPDOWN CLICK (MOBILE)
            document.querySelectorAll(".dropdown > a").forEach(menu => {
                menu.addEventListener("click", function (e) {
                    if (window.innerWidth <= 768) {
                        e.preventDefault();
                        this.parentElement.classList.toggle("active");
                    }
                });
            });

        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
