@{
    ViewData["Title"] = "NDT Inspection Services";
}

<link href="~/css/nondestruction.css" rel="stylesheet" />
<!-- HERO SECTION -->
<link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<script>
    AOS.init();
</script>
<section class="ndt-hero">

    <div class="ndt-hero-overlay"></div>

    <div class="ndt-hero-content" data-aos="fade-up">

        <h1>Non-Destructive Testing & Inspection Services</h1>

        <p>
            Reliable NDT Solutions for Oil & Gas, Power, Fabrication &
            Infrastructure Projects
        </p>

    </div>

</section>



<!-- INTRO SECTION -->

<section class="ndt-intro">

    <div class="ndt-container">

        <div class="ndt-grid">

            <div class="ndt-text" data-aos="fade-right">

                <h2>What is Non-Destructive Testing (NDT)?</h2>

                <p>
                    Non-Destructive Testing (NDT) is a vital inspection process used
                    to evaluate materials, welds, components and structures without
                    causing damage or affecting serviceability.
                </p>

                <p>
                    Once inspection is completed, the tested component remains fully
                    operational and fit for its intended purpose.
                </p>

                <p>
                    Our NDT & Inspection services help ensure structural integrity,
                    operational safety, regulatory compliance and long-term asset
                    reliability across critical industries.
                </p>

            </div>

            <div class="ndt-image" data-aos="fade-left">

                <img src="/image/what is ndt.jpg" alt="NDT inspection">

            </div>

        </div>

    </div>

</section>



<!-- INDUSTRIES SECTION -->

<section class="ndt-industries">

    <div class="ndt-container">

        <h2 class="section-title" data-aos="fade-up">Industries We Serve</h2>
        <div class="industry-grid">

            <!-- Oil & Gas -->
            <div class="industry-card" data-aos="fade-up">
                <img src="/image/oil and gas industry.png">

                <h3>Oil & Gas <span>(Upstream, Midstream & Downstream)</span></h3>

                <p>
                    We support refineries, pipelines, offshore and onshore facilities with inspections aimed at detecting:
                </p>

                <ul>
                    <li>Weld defects and fabrication flaws</li>
                    <li>Corrosion, erosion, and wall-thickness loss</li>
                    <li>In-service degradation due to pressure and temperature</li>
                </ul>

                <p class="highlight">
                    Our NDT services help minimize unplanned shutdowns and improve plant safety and reliability.
                </p>
            </div>


            <!-- Power Sector -->
            <div class="industry-card" data-aos="fade-up" data-aos-delay="100">
                <img src="/image/power sector.png">

                <h3>Power Sector <span>(Thermal, Hydro, Renewable & Nuclear)</span></h3>

                <p>
                    For power generation and transmission assets, we provide inspections to ensure:
                </p>

                <ul>
                    <li>Integrity of boilers, pressure parts, turbines, and piping</li>
                    <li>Compliance with statutory and design codes</li>
                    <li>Safe and continuous power generation</li>
                </ul>

                <p class="highlight">
                    NDT during outages and on-stream inspections helps reduce downtime and extend equipment life.
                </p>
            </div>


            <!-- Fabrication -->
            <div class="industry-card" data-aos="fade-up" data-aos-delay="200">
                <img src="/image/fabrication & manufacturing.png">

                <h3>Fabrication & Manufacturing</h3>

                <p>
                    We assist fabrication yards and manufacturers by performing:
                </p>

                <ul>
                    <li>Quality control inspections during fabrication and erection</li>
                    <li>Weld and material verification before dispatch</li>
                    <li>Compliance checks with international standards</li>
                </ul>

                <p class="highlight">
                    Our solutions reduce rework, optimize timelines, and control manufacturing costs.
                </p>
            </div>


            <!-- Infrastructure -->
            <div class="industry-card" data-aos="fade-up" data-aos-delay="300">
                <img src="/image/infrastructure.png">

                <h3>Infrastructure & Construction</h3>

                <p>
                    For bridges, buildings, metro projects, and industrial structures, our services ensure:
                </p>

                <ul>
                    <li>Structural soundness of steel and concrete components</li>
                    <li>Early detection of defects to prevent failures</li>
                    <li>Long-term durability and safety</li>
                </ul>

                <p class="highlight">
                    Reliable inspection services for long-lasting infrastructure performance.
                </p>
            </div>

        </div>
