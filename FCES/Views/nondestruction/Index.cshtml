<!-- BENEFITS SECTION -->

<section class="ndt-benefits">

    <div class="ndt-container">

        <h2 class="section-title" data-aos="fade-up">Benefits of Our NDT & Inspection Services</h2>

        <div class="benefits-grid">

            <div class="benefit-box" data-aos="zoom-in">Reduced Health, Safety, and Environmental (HSE) risks</div>
            <div class="benefit-box" data-aos="zoom-in">Lower manufacturing, construction, and maintenance costs</div>
            <div class="benefit-box" data-aos="zoom-in">Reduced plant downtime and fewer unplanned shutdowns</div>
            <div class="benefit-box" data-aos="zoom-in">Early detection of defects to prevent major failures</div>
            <div class="benefit-box" data-aos="zoom-in">Improved equipment availability and production efficiency</div>
            <div class="benefit-box" data-aos="zoom-in">Reduced risk of legal liability and reputational damage</div>
            <div class="benefit-box" data-aos="zoom-in">Documented compliance with design codes and standards</div>
            <div class="benefit-box" data-aos="zoom-in">One-stop inspection services from an independent inspection provider</div>

        </div>

    </div>

</section>



<!-- METHODS SECTION -->

<section class="ndt-methods">

    <div class="ndt-container">

        <h2 class="section-title" data-aos="fade-up">Our Conventional NDT Methods</h2>

        <div class="method-grid">

            <div class="method-card" data-aos="zoom-in">Magnetic Particle Testing (MPT)</div>
            <div class="method-card" data-aos="zoom-in">Dye Penetrant Testing (DPT)</div>
            <div class="method-card" data-aos="zoom-in">Radiographic Testing (RT)</div>
            <div class="method-card" data-aos="zoom-in">Ultrasonic Testing (UT)</div>
            <div class="method-card" data-aos="zoom-in">Positive Material Identification (PMI)</div>
            <div class="method-card" data-aos="zoom-in">Visual Testing (VT)</div>
            <div class="method-card" data-aos="zoom-in">Hardness Testing</div>

        </div>

    </div>

</section>
<section class="ndt-choose-card">

    <div class="ndt-container">

        <h2 class="section-title">Why Choose the Right NDT Solution?</h2>

        <div class="choose-card-grid">

            <!-- Card 1 -->
            <div class="choose-card" data-aos="fade-up">

                <h3>Selection Factors</h3>

                <p>
                    The selection of the appropriate NDT method depends on:
                </p>

                <ul class="icon-list">
                    <li>Type of material and component</li>
                    <li>Stage of inspection (fabrication, shutdown, or in-service)</li>
                    <li>Operating conditions and degradation mechanisms</li>
                </ul>

            </div>

            <!-- Card 2 -->
            <div class="choose-card" data-aos="fade-up" data-aos-delay="100">

                <h3>Industry Perspective</h3>

                <p>
                    Different stakeholders have different priorities:
                </p>

                <ul class="icon-list">
                    <li>Manufacturers focus on cost-effective quality assurance</li>
                    <li>Asset owners prioritize monitoring during service life</li>
                </ul>

                <p class="highlight">
                    We provide solutions that balance both requirements efficiently.
                </p>

            </div>

            <!-- Card 3 -->
            <div class="choose-card" data-aos="fade-up" data-aos-delay="200">

                <h3>Our Commitment</h3>

                <p>
                    We deliver accurate, timely, and reliable NDT & inspection services to help clients:
                </p>

                <ul class="icon-list">
                    <li>Maintain safe operations</li>
                    <li>Meet regulatory and project requirements</li>
                    <li>Extend asset life</li>
                    <li>Improve overall operational performance</li>
                </ul>

            </div>

        </div>

    </div>

</section>