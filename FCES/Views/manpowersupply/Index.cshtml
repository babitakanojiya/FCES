@{
    ViewData["Title"] = "Manpower Supply Services";
}

<link href="~/css/manpower.css" rel="stylesheet" />

<link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<script>
    AOS.init();
</script>

<!-- BG ANIMATION -->
<div class="bg-animation">
    <span></span><span></span><span></span><span></span><span></span>
</div>

<!-- HERO -->
<section class="tpi-hero">
    <div class="tpi-content" data-aos="fade-up">
        <h1>Manpower Supply Services</h1>
        <p>Skilled & Certified Manpower for Oil & Gas, Power, Fabrication & Infrastructure Projects</p>
    </div>
</section>

<!-- INTRO -->
<section class="tpi-about-section">
    <div class="tpi-container">

        <div class="tpi-about-grid">
            <div class="tpi-about-image" data-aos="fade-right">
                <img src="~/image/certified & project-ready workforce.png" />
            </div>

            <div class="tpi-about-content" data-aos="fade-left">
                <h2>Skilled, Certified & Project-Ready Workforce</h2>

                <p>
                    We provide qualified engineers, inspectors, supervisors, safety professionals,
                    technicians, and skilled tradesmen for Oil & Gas, Power, Fabrication,
                    and Infrastructure projects.
                </p>

                <p>
                    Our manpower is available for short-term, long-term, shutdown,
                    and EPC project deployment.
                </p>
            </div>
        </div>

    </div>
</section>

<!-- MANPOWER CARDS -->
<section class="manpower-section">
    <div class="tpi-container">

        <h2 class="section-title">
            <span class="icon-box"><i class="fas fa-users"></i></span>
            <span class="title-text">Manpower Categories</span>
        </h2>

        <div class="manpower-grid">

            <!-- QC -->
            <div class="manpower-card">
                <img src="~/image/quality control (qc) & inspection manpower.png" alt="QC Inspection" />

                <div class="manpower-content">
                    <h3><i class="fas fa-user-check"></i> QC & Inspection</h3>

                    <p>
                        Ensuring compliance with project specifications, codes, and quality
                        standards across fabrication, erection, and commissioning.
                    </p>

                    <h4>QC Engineers</h4>
                    <ul>
                        <li>Piping</li>
                        <li>Pipeline</li>
                        <li>Pressure Vessel</li>
                        <li>Heat Exchanger</li>
                        <li>Storage Tank</li>
                        <li>Structure</li>
                        <li>Blasting & Painting</li>
                    </ul>

                    <h4>Inspection Personnel</h4>
                    <ul>
                        <li>Inspection Engineer</li>
                        <li>Piping Inspector</li>
                    </ul>
                </div>
            </div>

            <!-- ENGINEERING -->
            <div class="manpower-card">
                
                <img src="~/image/engineering manpower.jpg" />
                <div class="manpower-content">
                    <h3><i class="fas fa-cogs"></i> Engineering Manpower</h3>

                    <p>
                        Experienced engineers managing design, execution,
                        testing, and commissioning activities.
                    </p>

                    <ul>
                        <li>Piping Engineer</li>
                        <li>Pipeline Engineer</li>
                        <li>Pressure Vessel Engineer</li>
                        <li>Storage Tank Engineer</li>
                        <li>Heat Exchanger Engineer</li>
                        <li>Structural Engineer</li>
                        <li>Hydro Test Engineer</li>
                    </ul>
                </div>
            </div>

            <!-- SUPERVISION -->
            <div class="manpower-card">
                
                <img src="~/image/supervision & site management.jpg" />
                <div class="manpower-content">
                    <h3><i class="fas fa-user-tie"></i> Supervision & Site Management</h3>

                    <p>
                        Supervisory staff ensuring smooth execution,
                        workforce coordination, and safety compliance.
                    </p>

                    <h4>Supervisors</h4>
                    <ul>
                        <li>Piping</li>
                        <li>Pipeline</li>
                        <li>Storage Tank</li>
                    </ul>

                    <h4>Foremen</h4>
                    <ul>
                        <li>Piping</li>
                        <li>Welding</li>
                        <li>Blasting & Painting</li>
                        <li>Hydro Test</li>
                        <li>Rigging</li>
                    </ul>
                </div>
            </div>

            <!-- NDT -->
            <div class="manpower-card">
                
                <img src="~/image/ndt & welding manpower.jpg" />
                <div class="manpower-content">
                    <h3><i class="fas fa-search"></i> NDT & Welding Manpower</h3>

                    <p>
                        Certified personnel for inspection and testing
                        as per codes and client requirements.
                    </p>

                    <h4>NDT Personnel</h4>
                    <ul>
                        <li>Technician</li>
                        <li>Inspector</li>
                        <li>Supervisor</li>
                    </ul>

                    <h4>Fabrication Workforce</h4>
                    <ul>
                        <li>Pipe Fabricator</li>
                        <li>Welder</li>
                    </ul>
                </div>
            </div>

            <div class="manpower-card">

                <img src="~/image/construction & mechanical manpower.jpg" />
                <div class="manpower-content">
                    <h3><i class="fas fa-search"></i> Construction & Mechanical Manpower</h3>

                    <p>
                        Skilled tradesmen with hands-on site experience to support fabrication, erection, and commissioning activities.


                    </p>
                    <ul>
                        <li>Pipe Fitter</li>
                        <li>Rigger</li>
                    </ul>
                </div>
            </div>
            <div class="manpower-card">

                <img src="~/image/project support & administration.jpg" />
                <div class="manpower-content">
                    <h3><i class="fas fa-search"></i> Project Support & Administration</h3>

                    <p>
                        Project Support & Administration


                    </p>
                    <ul>
                        •	Material Controller
                        •	Document Controller
                        •	Permit Holder

                        HSE & Safety Personnel

                        •	Safety Officer
                        •	HSE Supervisor
                        •	HSE Engineer

                    </ul>
                </div>
            </div>

        </div>

    </div>
</section>
<!-- WHY + INDUSTRIES -->
<section class="info-section">
    <div class="tpi-container">

        <h2 class="section-title">
            <span class="icon-box"><i class="fas fa-award"></i></span>
            <span class="title-text">Why Choose Our Manpower Services</span>
        </h2>

        <div class="info-grid">
            <div class="info-card"><i class="fas fa-user-check"></i><p>Qualified & experienced professionals</p></div>
            <div class="info-card"><i class="fas fa-industry"></i><p>Support for EPC & shutdown projects</p></div>
            <div class="info-card"><i class="fas fa-globe"></i><p>Compliance with industry standards</p></div>
            <div class="info-card"><i class="fas fa-clock"></i><p>Flexible deployment</p></div>
        </div>

        <h2 class="section-title">
            <span class="icon-box"><i class="fas fa-industry"></i></span>
            <span class="title-text">Industries We Support</span>
        </h2>

        <div class="info-grid">
            <div class="info-card"><i class="fas fa-oil-can"></i><p>Oil & Gas</p></div>
            <div class="info-card"><i class="fas fa-bolt"></i><p>Power Plants</p></div>
            <div class="info-card"><i class="fas fa-cogs"></i><p>Fabrication</p></div>
            <div class="info-card"><i class="fas fa-building"></i><p>Infrastructure</p></div>
        </div>

    </div>
</section>