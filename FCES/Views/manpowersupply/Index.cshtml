@{
    ViewData["Title"] = "Manpower Supply Services";
}

<link href="~/css/manpower.css" rel="stylesheet" />

<link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<script>
    AOS.init();
</script>

<!-- BG ANIMATION -->
<div class="bg-animation">
    <span></span><span></span><span></span><span></span><span></span>
</div>

<!-- HERO -->
<section class="tpi-hero">
    <div class="tpi-content" data-aos="fade-up">
        <h1>Manpower Supply Services</h1>
        <p>Skilled & Certified Manpower for Oil & Gas, Power, Fabrication & Infrastructure Projects</p>
    </div>
</section>

<!-- INTRO -->
<section class="tpi-about-section">
    <div class="tpi-container">

        <div class="tpi-about-grid">
            <div class="tpi-about-image" data-aos="fade-right">
                <img src="~/image/certified & project-ready workforce.png" />
            </div>

            <div class="tpi-about-content" data-aos="fade-left">
                <h2>Skilled, Certified & Project-Ready Workforce</h2>

                <p>
                    We provide qualified engineers, inspectors, supervisors, safety professionals,
                    technicians, and skilled tradesmen for Oil & Gas, Power, Fabrication,
                    and Infrastructure projects.
                </p>

                <p>
                    Our manpower is available for short-term, long-term, shutdown,
                    and EPC project deployment.
                </p>
            </div>
        </div>

    </div>
</section>

<!-- MANPOWER CARDS -->
<section class="manpower-section">
    <div class="tpi-container">

        <h2 class="section-title">
            <span class="icon-box"><i class="fas fa-users"></i></span>
            <span class="title-text">Manpower Categories</span>
        </h2>

        <div class="manpower-grid">

            <!-- QC -->
            <div class="manpower-card">
                <img src="~/image/quality control (qc) & inspection manpower new.jfif" alt="QC Inspection" />

                <div class="manpower-content">
                    <h3><i class="fas fa-user-check"></i>Quality Control (QC) & Inspection Manpower</h3>

                    <p>
                        Our QC and inspection professionals ensure adherence to project specifications, codes, and quality standards throughout fabrication, erection, and commissioning.
                    </p>

                    <h4>QC Engineers</h4>
                    <ul>
                        <li>QC Engineer – Piping           </li>
                        <li>QC Engineer – Pipeline         </li>
                        <li>QC Engineer – Pressure Vessel  </li>
                        <li>QC Engineer – Heat Exchanger   </li>
                        <li>QC Engineer – Storage Tank     </li>
                        <li>QC Engineer – Structure        </li>
                        <li>QC Engineer – Blasting         </li>
                        <li>QC Engineer – Painting         </li>

                    </ul>

                    <h4>Inspection Personnel</h4>
                    <ul>
                        <li>Inspection Engineer</li>
                        <li>Piping Inspector</li>
                    </ul>
                </div>
            </div>
            <div class="manpower-card">

                <img src="~/image/supervision & site management.jpg" />
                <div class="manpower-content">
                    <h3><i class="fas fa-user-tie"></i> Supervision & Site Management</h3>

                    <p>
                        Our supervisory staff ensure smooth execution, workforce coordination, and compliance with safety and quality requirements.
                    </p>

                    <h4>Supervisors</h4>
                    <ul>
                        <li>Piping Supervisor       </li>
                        <li>Pipeline Supervisor     </li>
                        <li>Storage Tank Supervisor </li>

                    </ul>

                    <h4>Foremen</h4>
                    <ul>

                        <li>Piping Foreman     </li>  
                        <li>Welding Foreman    </li>
                        <li>Welding Supervisor </li>
                        <li>Blasting Foreman   </li>
                        <li>Painting Foreman   </li>
                        <li>Hydro test Foreman </li>
                        <li>Rigging Foreman    </li>

                    </ul>
                </div>
            </div>

            <!-- ENGINEERING -->
            <div class="manpower-card">
                
                <img src="~/image/engineering manpower.jpg" />
                <div class="manpower-content">
                    <h3><i class="fas fa-cogs"></i> Engineering Manpower</h3>

                    <p>
                        We supply experienced engineers to manage design coordination, execution, testing, and commissioning activities.
                    </p>
                    <h4>Engineers</h4>
                    <ul>
                        <li>Piping Engineer</li>
                        <li>Pipeline Engineer</li>
                        <li>Pressure Vessel Engineer</li>
                        <li>Storage Tank Engineer</li>
                        <li>Heat Exchanger Engineer</li>
                        <li>Structural Engineer</li>
                        <li>Hydro Test Engineer</li>
                    </ul>
                </div>
            </div>

            <!-- SUPERVISION -->
            
            <!-- NDT -->
            <div class="manpower-card">
                
                <img src="~/image/ndt & welding manpower.jpg" />
                <div class="manpower-content">
                    <h3><i class="fas fa-search"></i> NDT & Welding Manpower</h3>

                    <p>
                        We provide certified personnel for inspection and testing activities in line with applicable codes and client requirements.
                    </p>

                    <h4>NDT Personnel</h4>
                    <ul>
                        <li>NDT Technician</li>
                        <li>NDT Inspector</li>
                        <li>NDT Supervisor</li>
                    </ul>

                    <h4>Welding & Fabrication Workforce</h4>
                    <ul>
                        <li>Pipe Fabricator</li>
                        <li>Welder</li>
                    </ul>
                </div>
            </div>

            <div class="manpower-card">

                <img src="~/image/construction & mechanical manpower.jpg" />
                <div class="manpower-content">
                    <h3><i class="fas fa-search"></i> Construction & Mechanical Manpower</h3>

                    <p>
                        Skilled tradesmen with hands-on site experience to support fabrication, erection, and commissioning activities.


                    </p>
                    <ul>
                        <li>Pipe Fitter</li>
                        <li>Rigger</li>
                    </ul>
                </div>
            </div>
            <div class="manpower-card">

                <img src="~/image/project support & administration.jpg" />
                <div class="manpower-content">
                    <h3><i class="fas fa-search"></i> Project Support & Administration</h3>

                    <p>
                        Reliable support staff to manage documentation, materials, and site permits efficiently.

                    </p>
                    <ul>
                        <li>Material Controller  </li>
                        <li>Document Controller  </li>
                        <li>Permit Holder        </li>
                        </ul>
                        <h4>HSE & Safety Personnel</h4>
                        <ul></li>
                        <li>Safety Officer </li>
                        <li>HSE Supervisor </li>
                        <li>HSE Engineer</li>

                     </ul>
                </div>
            </div>

        </div>

    </div>
</section>
<!-- WHY + INDUSTRIES -->


<section class="info-section">
    <div class="tpi-container">

        <!-- WHY CHOOSE -->
        <h2 class="section-title">
            <span class="icon-box"><i class="fas fa-award"></i></span>
            <span class="title-text">Why Choose Our Manpower Supply Services?</span>
        </h2>

        <div class="info-grid">
            <div class="info-card">
                <i class="fas fa-user-check"></i>
                <p>Industry-experienced and technically qualified professionals</p>
            </div>

            <div class="info-card">
                <i class="fas fa-tools"></i>
                <p>Available for shutdowns, maintenance, and EPC projects</p>
            </div>

            <div class="info-card">
                <i class="fas fa-globe"></i>
                <p>Compliance with Oil & Gas, Power, and Infrastructure standards</p>
            </div>

            <div class="info-card">
                <i class="fas fa-clock"></i>
                <p>Flexible deployment (short-term / long-term / project-based)</p>
            </div>

            <div class="info-card">
                <i class="fas fa-layer-group"></i>
                <p>One-stop solution for technical, supervisory, and skilled manpower</p>
            </div>
        </div>

        <!-- INDUSTRIES -->
        <h2 class="section-title">
            <span class="icon-box"><i class="fas fa-industry"></i></span>
            <span class="title-text">Industries We Support</span>
        </h2>

        <div class="info-grid">
            <div class="info-card">
                <i class="fas fa-oil-can"></i>
                <p>Oil & Gas (Onshore & Offshore)</p>
            </div>

            <div class="info-card">
                <i class="fas fa-bolt"></i>
                <p>Power Plants (Thermal, Hydro, Renewable)</p>
            </div>

            <div class="info-card">
                <i class="fas fa-cogs"></i>
                <p>Fabrication Yards</p>
            </div>

            <div class="info-card">
                <i class="fas fa-flask"></i>
                <p>Refineries & Petrochemical Plants</p>
            </div>

            <div class="info-card">
                <i class="fas fa-building"></i>
                <p>Infrastructure & Heavy Construction Projects</p>
            </div>
        </div>

    </div>
</section>