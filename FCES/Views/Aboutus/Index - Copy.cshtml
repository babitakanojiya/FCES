@{
    ViewData["Title"] = "About Us";
}

<style>
    /* BACKGROUND IMAGE BOX */
    .about-box {
        position: relative;
        height: 100%;
        min-height: 280px;
        background-image: url('/Image/aboutasbody.jpg') !important;
        background-size: cover !important;
        background-repeat: no-repeat !important;
        background-position: center !important;
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }


    /* DARK OVERLAY */
    .about-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.55); /* adjustable darkness */
    }

    /* TEXT OVER IMAGE */
    .about-text {
        position: relative;
        color: #fff;
        text-align: center;
        padding: 30px;
        z-index: 2;
        animation: fadeIn 1.5s ease-in-out;
    }

        .about-text h3 {
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .about-text p {
            font-size: 18px;
            line-height: 1.6;
        }

    /* MOBILE RESPONSIVE */
    @@media (max-width: 768px) {
        .about-text h3

    {
        font-size: 22px;
    }

    .about-text p {
        font-size: 16px;
    }

    }

    /* HERO IMAGE */
    .hero-section {
        position: relative;
        width: 100%;
        height: 350px;
        background-image: url('/image/aboutus.jpg'); /* change your image path */
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* TEXT OVER IMAGE */
    .hero-title {
        font-size: 48px;
        font-weight: 700;
        color: #ffffff;
        text-shadow: 0px 3px 10px rgba(0,0,0,0.6);
        animation: fadeIn 1.5s ease-in-out;
    }

    /* Fade Animation */
    @@keyframes fadeIn {
        0%

    {
        opacity: 0;
        transform: translateY(20px);
    }

    100% {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* CONTENT SECTION */
    .content-section {
        padding: 50px 15px;
        max-width: 1200px;
        margin: auto;
    }

    .content-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
    }

    .content-box {
        background: lavenderblush;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.1);
        font-size: 18px;
        line-height: 1.6;
        color: #333;
    }

    /* RESPONSIVE */
    @@media (max-width: 768px) {
        .content-row

    {
        grid-template-columns: 1fr;
    }

    .hero-title {
        font-size: 32px;
    }

    }
</style>

<!-- HERO IMAGE WITH TEXT -->
<div class="hero-section">
    <h1 class="hero-title">ABOUT US</h1>
</div>

<!-- BODY CONTENT -->
<div class="content-section">
    <div class="content-row">

        
        <div class="content-box about-box">
            <div class="about-overlay"></div>
            <div class="about-text">
                <h3><b>About </b></h3>
                <p>
                    FOURM CONSULTING AND ENGINEERS SERVICES (FCES)
                </p>
            </div>
        </div>

        <!-- RIGHT PART TEXT -->
        <div class="content-box">
            <h3><b>Institute of NDT and Inspection Technology</b></h3>
            <p>
                The institute is established for the advancement of <b>Science & Technology</b>,
                focusing on the application of <b>Non-Destructive Testing (NDT)</b> and imparting
                specialized skills to professionals in NDT and Quality Control.
                <br /><br />
                Promoted by NDT Professionals with vast experience in India and abroad,
                FCES ensures its faculty have extensive exposure to Indian and International
                companies in <b>Quality Control</b>, NDT, and Safety Engineering.
                <br /><br />
                Our Institute has a <b>state-of-the-art campus</b>strategically located with easy
                access to major industrial undertakings, positioning us as a key training hub
                for the industry.
            </p>
        </div>

    </div>
</div>
