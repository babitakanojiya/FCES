@{
    ViewData["Title"] = "Certificate Verification";
}
<link href="~/css/allcertificate.css" rel="stylesheet" />


<section class="tpi-hero">
    <div class="tpi-content" data-aos="fade-up">
        <h1>Certificate Verification</h1>
        
    </div>
</section>

<!-- SEARCH BOX -->
<div style="text-align:center; margin-top:30px;">

    <form method="post" asp-action="Verify">
        <input type="text" name="certificateNo"
               placeholder="Enter Certificate Number"
               style="padding:10px; width:300px;" required />

        <button type="submit" style="padding:10px 20px;">
            Verify
        </button>
    </form>

    @if (ViewBag.Message != null)
    {
        <p style="color:red; margin-top:15px;">
            @ViewBag.Message
        </p>
    }

</div>