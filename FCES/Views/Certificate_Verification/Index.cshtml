<hr style="margin:40px 0;" />

<div id="result-section">

    @if (ViewBag.IsValid != null)
    {
        @* if (ViewBag.IsValid == true)
        {
            <h3 style="color:green; text-align:center;">✔ Certificate Verified</h3>

            <!-- ✅ LOAD YOUR EXISTING VIEW HERE -->
            @await Html.PartialAsync("~/Views/Certificate_Verification/CertificateView.cshtml", Model)
        } *@
        @if (ViewBag.IsValid == true)
        {
            <div class="verify-success-card">

                <!-- HEADER -->
                <div class="verify-header">
                    <div class="verify-icon">✔</div>

                    <h2>Certificate Verified</h2>

                    <p>
                        This certificate is officially verified and issued by
                        <b>Fourm Consulting Engineers</b>.
                    </p>

                    @* <span class="verify-badge">VERIFIED</span> *@
                </div>

                <!-- CERTIFICATE -->
                <div class="verify-certificate">
                    <partial name="~/Views/Certificate_Verification/CertificateView.cshtml" model="Model" />
                </div>

            </div>
        }
        else
        {
            <div class="notfound-card">

                <div class="icon">❌</div>

                <h2>Certificate Not Found</h2>

                <p>
                    The certificate is not available in our records.<br />
                    Please complete your course and register to get certified.
                </p>

                <a href="/Registration" class="register-btn">
                    Register Now
                </a>

            </div>
        }
    }
    
</div>