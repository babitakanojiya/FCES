@{
    ViewData["Title"] = "TPI Services";
}

<link href="~/css/third-party mechanical.css" rel="stylesheet" />

<link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<script>
    AOS.init();
</script>

<!-- BACKGROUND ANIMATION -->
<div class="bg-animation">
    <span></span><span></span><span></span><span></span><span></span>
</div>

<!-- HERO -->
<section class="tpi-hero">
    <div class="tpi-content" data-aos="fade-up">
        <h1>Third-Party Mechanical Inspection Services</h1>
        <p>Reliable Inspection for Oil & Gas, Power & Infrastructure</p>
    </div>
</section>

<section class="tpi-about-section">

    <div class="tpi-container">

        <!-- ROW 1 -->
        <div class="tpi-about-grid">

            <!-- IMAGE -->
            <div class="tpi-about-image" data-aos="fade-right">
                
                <img src="/image/independent & reliable inspection for oil & gas.jpg" alt="Oil & Gas Inspection">
                @* <div class="overlay-text">Independent Inspection</div> *@
            </div>

            <!-- TEXT -->
            <div class="tpi-about-content" data-aos="fade-left">

                <h2>Independent & Reliable Inspection</h2>

                <p>
                    Independent & Reliable Inspection for Oil & Gas, Power, Fabrication & Infrastructure Projects.
                </p>

                <p>
                    We provide Third-Party Mechanical Inspection (TPI) services to ensure materials, equipment,
                    fabrication, installation, and testing activities comply with applicable codes, standards,
                    project specifications, and statutory requirements.
                </p>

                <p>
                    As an independent inspection service provider, we support asset owners, EPC contractors,
                    and manufacturers by delivering unbiased quality verification throughout the project lifecycle.
                </p>

            </div>

        </div>

        <!-- ROW 2 -->
        <div class="tpi-about-grid reverse">

            <!-- TEXT -->
            <div class="tpi-about-content" data-aos="fade-right">

                <h2>Full Lifecycle Inspection Scope of TP Mechanical Inspection Services</h2>

                <p>
                    Our inspection services cover all stages of engineering, procurement, fabrication,
                    construction, testing, and commissioning.
                </p>

                <p>
                    We ensure quality, compliance, and safety at every stage of the project lifecycle,
                    reducing risk and improving operational efficiency.
                </p>

            </div>

            <!-- IMAGE -->
            <div class="tpi-about-image" data-aos="fade-left">
                <img src="/image/scope of third-party mechanical inspection services.jpg" alt="Mechanical Inspection">
                @* <div class="overlay-text">Full Lifecycle Inspection</div> *@
            </div>

        </div>

    </div>

</section>

<!-- INTRO -->
@* <section>
    <div class="tpi-container">
        <p data-aos="fade-up">
            We provide independent inspection services ensuring compliance with international standards.
        </p>
    </div>
</section> *@

<!-- SERVICES -->
<section>
    <div class="tpi-container">
        @* <h2 class="section-title">Inspection Services</h2> *@
        <h2 class="section-title">
            <span class="icon-box">
                <i class="fas fa-tools"></i>
            </span>
            <span class="title-text">Inspection Services</span>
        </h2>
        <div class="tpi-grid">
            <div class="tpi-card" data-aos="zoom-in">
                <img src="/image/Material Inspection.png" alt="Material & Incoming Inspection" />

                <div class="tpi-card-content">
                    <h3>Material & Incoming Inspection</h3>

                    <p>
                        Verification of raw materials before fabrication and installation
                        to ensure compliance and traceability.
                    </p>

                    <ul>
                        <li>Review of Material Test Certificates (MTC / MTR)</li>
                        <li>Chemical & mechanical property verification</li>
                        <li>Positive Material Identification (PMI)</li>
                        <li>Visual and dimensional inspection of pipes, plates, fittings, flanges, and forgings</li>
                        <li>Heat number traceability verification</li>
                    </ul>
                </div>
            </div>

            <div class="tpi-card" data-aos="zoom-in">
                <img src="/image/Welding & Fabrication Inspection.png" />
                <div class="tpi-card-content">
                    <h3>Welding & Fabrication Inspection</h3>
                    <p>Monitoring and verification of fabrication and welding activities.</p>
                    <ul>

                        <li>Review & approval of WPS, PQR, and WQT       </li>
                        <li>Fit-up and joint preparation inspection      </li>
                        <li>Monitoring of welding parameters             </li>
                        <li>Visual inspection of welds                   </li>
                        <li>Weld identification and traceability control </li>

                    </ul>
                </div>
            </div>

            <div class="tpi-card" data-aos="zoom-in">
                <img src="~/image/non-destructive testing (ndt) surveillance.jpg" />
                <div class="tpi-card-content">
                    <h3>Non-Destructive Testing (NDT) Surveillance</h3>
                    <p>
                        Independent witnessing and review of NDT activities to ensure defect-free components.
                    </p>
                    <ul>

                        <li>Visual Testing (VT)             </li>
                        <li>Magnetic Particle Testing (MPT) </li>
                        <li>Dye Penetrant Testing (DPT)     </li>
                        <li>Ultrasonic Testing (UT)         </li>
                        <li>Radiographic Testing (RT)       </li>
                        <li>Hardness Testing                </li>

                    </ul>
                    <p>Includes verification of procedures, personnel qualification, and NDT reports.</p>
                </div>
            </div>

            <div class="tpi-card" data-aos="zoom-in">
                <img src="~/image/pressure vessel & heat exchanger inspection.jpg" />
                <div class="tpi-card-content">
                    <h3>Pressure Vessel & Heat Exchanger Inspection</h3>
                    <p>Comprehensive inspection services for pressure equipment.</p>
                    <ul>
                        <li>Design & drawing review                   </li>
                        <li>Material verification and traceability    </li>
                        <li>Welding & NDT surveillance                </li>
                        <li>Dimensional inspection                    </li>
                        <li>Nozzle orientation & alignment checks     </li>
                        <li>Hydrostatic / pneumatic test witnessing   </li>
                        <li>Nameplate & marking verification          </li>
                                                                      
                    </ul>
                </div>
            </div>

            <div class="tpi-card" data-aos="zoom-in">
                <img src="~/image/piping & pipeline inspection.jpg" />
                <div class="tpi-card-content">
                    <h3>Piping & Pipeline Inspection</h3>
                    <p>Inspection services covering fabrication, erection, and testing.</p>
                    <ul>
                        <li>Line class & isometric verification       </li>   
                        <li>Fit-up, welding, and NDT inspection       </li>
                        <li>Pipe support & alignment inspection       </li>
                        <li>Flange management & bolting verification  </li>
                        <li>Hydro test / pneumatic test witnessing    </li>
                        <li>System walk-down and punch list clearance </li>

                    </ul>
                </div>
            </div>
            <div class="tpi-card" data-aos="zoom-in">
                <img src="~/image/storage tank inspection.jpg" />
                <div class="tpi-card-content">
                    <h3>Storage Tank Inspection</h3>
                    <p>Inspection of atmospheric and low-pressure storage tanks.</p>
                    <ul>
                        <li>Material inspection                          </li>
                        <li>Bottom, shell, and roof welding inspection   </li>
                        <li>Vacuum box testing                           </li>
                        <li>Settlement & roundness checks                </li>
                        <li>Hydro test witnessing                        </li>
                        <li>Final inspection & certification             </li>
                                                                         

                    </ul>
                </div>
            </div>
            <div class="tpi-card" data-aos="zoom-in">
                <img src="~/image/structural steel inspection.jpg" />
                <div class="tpi-card-content">
                    <h3>Structural Steel Inspection</h3>
                    <p>Ensuring integrity and compliance of steel structures.</p>
                    <ul>
                        <li>Material verification              </li>
                        <li>Welding & bolting inspection       </li>
                        <li>Dimensional checks                 </li>
                        <li>NDT of structural welds            </li>
                        <li>Erection and alignment inspection  </li>



                    </ul>
                </div>
            </div>
            <div class="tpi-card" data-aos="zoom-in">
                <img src="~/image/blasting, painting & coating inspection.jpg" />
                <div class="tpi-card-content">
                    <h3>Blasting, Painting & Coating Inspection</h3>
                    <p>
                        Inspection of corrosion protection systems.

                    </p>
                    <ul>
                        <li>Review of coating specifications                  </li>
                        <li>Surface preparation & cleanliness verification    </li>
                        <li>Surface profile measurement                       </li>
                        <li>Environmental condition monitoring                </li>
                        <li>Dry Film Thickness (DFT) measurement              </li>
                        <li>Holiday / porosity testing                        </li>
                                                                              
                    </ul>
                </div>
            </div>
            <div class="tpi-card" data-aos="zoom-in">
                <img src="~/image/mechanical installation & erection inspection.jpg" />
                <div class="tpi-card-content">
                    <h3>Mechanical Installation & Erection Inspection</h3>
                    <p>
                        Inspection during site installation of mechanical equipment.

                    </p>
                    <ul>
                        <li>Equipment foundation & grouting inspection  </li>
                        <li>Alignment verification                      </li>
                        <li>Bolt torque & tightening checks             </li>
                        <li>Clearance and accessibility verification    </li>
                    </ul>
                </div>
            </div>
            <div class="tpi-card" data-aos="zoom-in">
                <img src="~/image/testing, commissioning & pre-start-up inspection.jpg" />
                <div class="tpi-card-content">
                    <h3>
                        Testing, Commissioning & Pre-Start-up Inspection

                    </h3>
                    <p>
                        Final verification before handover and commissioning.

                    </p>
                    <ul>

                        <li>Hydrostatic & pneumatic test witnessing </li>
                        <li>Mechanical completion verification      </li>
                        <li>Pre-Startup Safety Inspection (PSSI)    </li>
                        <li>Punch list verification and closure     </li>
                        <li>Final acceptance inspection             </li>
                                                                    
                    </ul>
                </div>
            </div>
            <div class="tpi-card" data-aos="zoom-in">
                <img src="~/image/documentation & final dossier review.jpg" />
                <div class="tpi-card-content">
                    <h3>Documentation & Final Dossier Review</h3>
                    <p>Verification and approval of quality documentation.</p>
                    <ul>

                        <li>Review of material, welding, and NDT records                </li>
                        <li>Calibration certificates verification                       </li>
                        <li>As-built drawing review                                     </li>
                        <li>Mechanical Completion Dossier (MDR / QC Dossier) approval   </li>

                    </ul>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- TABLE -->
<section>
    <div class="tpi-container">

        <h2 class="section-title">
            <span class="icon-box">
                <i class="fas fa-tasks"></i>
            </span>
            <span class="title-text">Third-Party Mechanical Inspection Services – Scope Table</span>
        </h2>

        <div class="table-wrapper" data-aos="fade-up">
            <table class="tpi-table">
                <thead>
                    <tr>
                        <th>Inspection Category</th>
                        <th>Inspection Activities Covered</th>
                        <th>Applicable Equipment / Area</th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td>Material Inspection</td>
                        <td>MTC/MTR review, PMI, visual & dimensional inspection, traceability</td>
                        <td>Pipes, plates, fittings, flanges, forgings</td>
                    </tr>

                    <tr>
                        <td>Welding Inspection</td>
                        <td>WPS/PQR/WQT review, fit-up inspection, weld visual inspection, welding surveillance</td>
                        <td>Piping, pipelines, pressure vessels, tanks, structures</td>
                    </tr>

                    <tr>
                        <td>NDT Inspection</td>
                        <td>VT, MPT, DPT, UT, RT, hardness testing, report review & witnessing</td>
                        <td>Welds, base materials, fabricated components</td>
                    </tr>

                    <tr>
                        <td>Pressure Vessel Inspection</td>
                        <td>Design review, fabrication inspection, NDT, dimensional checks, hydro test witnessing</td>
                        <td>Pressure vessels, reactors</td>
                    </tr>

                    <tr>
                        <td>Heat Exchanger Inspection</td>
                        <td>Tube inspection, welding & NDT, alignment, hydro test witnessing</td>
                        <td>Shell & tube, air-cooled heat exchangers</td>
                    </tr>

                    <tr>
                        <td>Piping Inspection</td>
                        <td>Isometric verification, welding & NDT, flange management, hydro test</td>
                        <td>Process piping, utility piping</td>
                    </tr>

                    <tr>
                        <td>Pipeline Inspection</td>
                        <td>Welding inspection, NDT, coating inspection, field joint inspection, hydro test</td>
                        <td>Cross-country & plant pipelines</td>
                    </tr>

                    <tr>
                        <td>Storage Tank Inspection</td>
                        <td>Plate inspection, welding, vacuum box test, settlement check, hydro test</td>
                        <td>Atmospheric & low-pressure tanks</td>
                    </tr>

                    <tr>
                        <td>Structural Steel Inspection</td>
                        <td>Material check, welding & bolting inspection, dimensional & alignment checks</td>
                        <td>Pipe racks, platforms, structures</td>
                    </tr>

                    <tr>
                        <td>Blasting & Painting Inspection</td>
                        <td>Surface preparation, profile measurement, DFT, holiday testing</td>
                        <td>Piping, tanks, structures</td>
                    </tr>

                    <tr>
                        <td>Mechanical Installation Inspection</td>
                        <td>Foundation, grouting, alignment, bolt tightening</td>
                        <td>Pumps, compressors, static equipment</td>
                    </tr>

                    <tr>
                        <td>Testing & Commissioning</td>
                        <td>Hydro / pneumatic tests, mechanical completion, PSSI</td>
                        <td>All mechanical systems</td>
                    </tr>

                    <tr>
                        <td>Documentation Review</td>
                        <td>QC dossier, MDR, as-built drawings, test records</td>
                        <td>Project final documentation</td>
                    </tr>

                </tbody>
            </table>
        </div>

    </div>
</section>
<section class="codes-section">
    <div class="tpi-container">

        <h2 class="section-title">
            <span class="icon-box">
                <i class="fas fa-book"></i>
            </span>
            <span class="title-text">Codes & Standards Mapping – Mechanical Inspection</span>
        </h2>

        <div class="codes-grid">

            <!-- ASME -->
            <div class="code-card">
                <h3>ASME (American Society of Mechanical Engineers)</h3>
                <table>
                    <tr><th>Code</th><th>Application</th></tr>
                    <tr><td>ASME Section I</td><td>Power boilers</td></tr>
                    <tr><td>ASME Section VIII Div. 1 & 2</td><td>Pressure vessels</td></tr>
                    <tr><td>ASME Section IX</td><td>Welding & welder qualification</td></tr>
                    <tr><td>ASME B31.1</td><td>Power piping</td></tr>
                    <tr><td>ASME B31.3</td><td>Process piping</td></tr>
                    <tr><td>ASME B31.4</td><td>Liquid pipelines</td></tr>
                    <tr><td>ASME B31.8</td><td>Gas pipelines</td></tr>
                    <tr><td>ASME PCC-2</td><td>Repair of pressure equipment & piping</td></tr>
                </table>
            </div>

            <!-- API -->
            <div class="code-card">
                <h3>API (American Petroleum Institute)</h3>
                <table>
                    <tr><th>Standard</th><th>Application</th></tr>
                    <tr><td>API 510</td><td>Pressure vessel inspection</td></tr>
                    <tr><td>API 570</td><td>Piping inspection</td></tr>
                    <tr><td>API 650</td><td>Welded steel storage tanks</td></tr>
                    <tr><td>API 653</td><td>Tank inspection, repair & alteration</td></tr>
                    <tr><td>API 1104</td><td>Pipeline welding</td></tr>
                    <tr><td>API RP 571</td><td>Damage mechanisms</td></tr>
                    <tr><td>API RP 574</td><td>Piping inspection practices</td></tr>
                </table>
            </div>

            <!-- ISO -->
            <div class="code-card">
                <h3>ISO (International Organization for Standardization)</h3>
                <table>
                    <tr><th>Standard</th><th>Application</th></tr>
                    <tr><td>ISO 9001</td><td>Quality Management System</td></tr>
                    <tr><td>ISO 9712</td><td>NDT personnel qualification</td></tr>
                    <tr><td>ISO 3834</td><td>Welding quality requirements</td></tr>
                    <tr><td>ISO 8501 / 8502 / 8503</td><td>Surface preparation & blasting</td></tr>
                    <tr><td>ISO 12944</td><td>Protective coating systems</td></tr>
                    <tr><td>ISO 15614</td><td>Welding procedure qualification</td></tr>
                    <tr><td>ISO 9606</td><td>Welder qualification</td></tr>
                </table>
            </div>

            <!-- IS -->
            <div class="code-card">
                <h3>IS (Indian Standards – BIS)</h3>
                <table>
                    <tr><th>Code</th><th>Application</th></tr>
                    <tr><td>IS 2825</td><td>Pressure vessels</td></tr>
                    <tr><td>IS 803</td><td>Design of steel structures</td></tr>
                    <tr><td>IS 9595</td><td>Piping fabrication</td></tr>
                    <tr><td>IS 2062</td><td>Structural steel materials</td></tr>
                    <tr><td>IS 822</td><td>Welding electrodes</td></tr>
                    <tr><td>IS 1477</td><td>Painting & coating</td></tr>
                    <tr><td>IS 1172</td><td>Industrial piping</td></tr>
                </table>
            </div>

        </div>
    </div>
</section>
<section class="compliance-section">
    <div class="tpi-container">

        <div class="compliance-box" data-aos="fade-up">

            <div class="compliance-icon">
                <i class="fas fa-user-shield"></i>
            </div>

            <div class="compliance-content">
                <h3>Inspection Compliance Statement</h3>
                <p>
                    Our third-party mechanical inspection services are carried out in compliance with
                    <strong>ASME, API, ISO, and IS codes</strong>, ensuring quality, safety, and regulatory
                    conformity across Oil & Gas, Power, Fabrication, and Infrastructure projects.
                </p>
            </div>

        </div>
    </div>
</section>
